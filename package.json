{
  "name": "t3rmes",
  "version": "0.0.1",
  "private": true,
  "main": "electron/main.cjs",
  "description": "A small, fast desktop client for Hermes Agent.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5175",
    "dev:electron": "wait-on http://127.0.0.1:5175 && env -u ELECTRON_RUN_AS_NODE electron .",
    "build": "vite build",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "concurrently": "latest",
    "effect": "^4.1.4",
    "electron": "latest",
    "lucide-react": "^1.73.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vite": "latest",
    "wait-on": "latest"
  }
}
