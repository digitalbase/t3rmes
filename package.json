{
  "name": "t3rmes",
  "version": "0.0.1",
  "private": true,
  "main": "electron/main.cjs",
  "description": "A small, fast desktop client for Hermes Agent.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5175",
    "dev:electron": "wait-on http://127.0.0.1:5175 && env -u ELECTRON_RUN_AS_NODE electron .",
    "build": "vite build",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "smoke-test": "node scripts/smoke-test.mjs",
    "dist": "vite build && electron-builder --linux AppImage",
    "dist:linux": "vite build && electron-builder --linux --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@pierre/diffs": "^1.6.4",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "concurrently": "latest",
    "effect": "^4.1.4",
    "electron": "latest",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.73.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "eu.digitalbase.t3rmes",
    "productName": "T3rmes",
    "executableName": "t3rmes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "synopsis": "A small, fast desktop client for Hermes Agent",
      "maintainer": "digitalbase <gijs@digitalbase.eu>",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "T3rmes-${version}.AppImage"
    },
    "deb": {
      "artifactName": "t3rmes_${version}_${arch}.deb"
    },
    "pacman": {
      "artifactName": "t3rmes-${version}-${arch}.pacman"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "dmg": {
      "artifactName": "T3rmes-${version}-${arch}.dmg"
    }
  },
  "author": "digitalbase <gijs@digitalbase.eu>",
  "homepage": "https://github.com/digitalbase/t3rmes",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalbase/t3rmes.git"
  },
  "desktopName": "t3rmes.desktop"
}
